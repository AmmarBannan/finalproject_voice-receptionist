{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clinic-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "services.clinic_api:app", "--port", "8101"],
      "port": 8101
    },
    {
      "name": "app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["ui/app_ui.py"],
      "port": 7860
    }
  ]
}
