# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4.1-mini

# --- Simulated clinic (services/) -------------------------------------------
# Where the clinic API runs. In docker compose your app uses http://clinic-api:8101
CLINIC_API_URL=http://localhost:8101
# Shared by the API and the MCP server. Empty = dev-key-change-me
CLINIC_API_KEY=
# Freeze "today" (YYYY-MM-DD). The clock then reads 08:00 on that day. Empty = real date and time.
# The sample eval cases expect CLINIC_TODAY=2026-11-02 (a Monday).
CLINIC_TODAY=
# Clock time used with CLINIC_TODAY (HH:MM). Empty = 08:00
CLINIC_TIME=
# Seconds the MCP server waits for the API. Empty = 10
CLINIC_HTTP_TIMEOUT=

# --- Voice (voice/) ---------------------------------------------------------
# Speech-to-text: openrouter (default) or whisper_local (pip install faster-whisper)
STT_PROVIDER=openrouter
STT_MODEL=google/gemini-2.5-flash-lite
# Tried by OpenRouter when STT_MODEL fails (for example rate-limited). Empty = no fallback
STT_FALLBACK_MODEL=mistralai/voxtral-small-24b-2507
# whisper_local model size: tiny, base, small
WHISPER_MODEL=base
# Text-to-speech: piper (default, offline voices) or browser (the UI speaks the reply)
TTS_PROVIDER=piper
# English: LJ Speech data, public domain. en_US-lessac-medium also works but its data is research-only:
# do not use it in a published demo.
PIPER_VOICE_EN=en_US-ljspeech-medium
# Arabic: the only ar_JO voice; its model card states no clear licence (see README). Alternative: TTS_PROVIDER=browser
PIPER_VOICE_AR=ar_JO-kareem-medium
# Where Piper voices are stored. Empty = voice/models
PIPER_MODELS_DIR=

# --- UI and evals -----------------------------------------------------------
# Your app (the API contract) for ui/app_ui.py and evals/run_evals.py
APP_URL=http://localhost:8000
