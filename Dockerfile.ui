# The Gradio UI (:7860), a client of the API contract.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GRADIO_SERVER_NAME=0.0.0.0
WORKDIR /app
RUN pip install --no-cache-dir gradio==6.30.0 httpx==0.28.1 python-dotenv==1.2.4
COPY ui/ ./ui/

EXPOSE 7860
CMD ["python", "ui/app_ui.py"]
